{
  "uid": "cinema-aggregator",
  "title": "Cinema Aggregator Service",
  "tags": ["cinema", "aggregator", "service"],
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by (endpoint)(rate(http_requests_total{job=\"aggregator\"}[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "s", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.50, sum by (le)(rate(http_request_duration_seconds_bucket{job=\"aggregator\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le)(rate(http_request_duration_seconds_bucket{job=\"aggregator\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.99, sum by (le)(rate(http_request_duration_seconds_bucket{job=\"aggregator\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate %",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum(rate(http_requests_total{job=\"aggregator\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"aggregator\"}[5m]))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1000},
              {"color": "red", "value": 5000}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "max by (topic)(kafka_consumer_lag{job=\"aggregator\"})",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kafka Messages Consumed/s",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(kafka_messages_consumed_total{job=\"aggregator\"}[1m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Event Processing Delay p95",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le)(rate(event_processing_delay_seconds_bucket[5m])))",
          "legendFormat": "p95 delay"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request Latency Heatmap",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "options": {
        "calculate": false,
        "yAxis": {"unit": "s"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by (le)(rate(http_request_duration_seconds_bucket{job=\"aggregator\"}[1m]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
