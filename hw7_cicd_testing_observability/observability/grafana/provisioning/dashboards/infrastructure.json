{
  "uid": "cinema-infrastructure",
  "title": "Cinema Infrastructure",
  "description": "Infrastructure monitoring: Kafka, PostgreSQL, ClickHouse, containers. Answers: Where is the bottleneck?",
  "tags": ["cinema", "infrastructure", "kafka", "postgres"],
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Kafka Consumer Lag by Group",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1000},
              {"color": "red", "value": 5000}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by (consumergroup, topic)(kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}/{{topic}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Kafka Topic Message Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "msgps", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by (topic)(rate(kafka_topic_partition_current_offset[1m]))",
          "legendFormat": "{{topic}} offset rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "PostgreSQL Active Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 100}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active connections"
        }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.99}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read) + 1)",
          "legendFormat": "Cache Hit Ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name=~\"hw7.*\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "container_memory_working_set_bytes{name=~\"hw7.*\", name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Kafka Brokers Online",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "green", "value": 3}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "count(kafka_brokers)",
          "legendFormat": "Brokers"
        }
      ]
    },
    {
      "id": 8,
      "title": "Targets Up",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum(up)",
          "legendFormat": "UP"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
