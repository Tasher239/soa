<?xml version="1.0"?>
<!--
  Cinema-specific ClickHouse overrides. Loaded from /etc/clickhouse-server/config.d/
  on top of the server's built-in config.xml. Drop-in format is merged, not replaced.
-->
<clickhouse>
    <!-- Expose HTTP/native listeners to other docker-compose services. -->
    <listen_host>0.0.0.0</listen_host>

    <!-- More verbose logging for the Kafka engine ingestion path. -->
    <logger>
        <level>information</level>
        <console>true</console>
    </logger>

    <!--
      Kafka engine uses librdkafka under the hood; these settings apply to every
      table with ENGINE = Kafka. They mirror the producer's high-throughput config
      (see producer core/config.py) so consumer-side fetches don't throttle ingestion.
    -->
    <kafka>
        <!-- Default consumer-level compression support (zstd is producer-side) -->
        <auto_offset_reset>earliest</auto_offset_reset>
        <!-- Avoid noisy INVALID_SESSION_TIMEOUT on slow initial rebalances -->
        <session_timeout_ms>30000</session_timeout_ms>
        <max_poll_interval_ms>600000</max_poll_interval_ms>
        <!-- Honour AvroConfluent magic byte even on schema resolution hiccups -->
        <debug>cgrp,topic,fetch</debug>
    </kafka>

    <!--
      Enable query_log and trace_log so demo / debugging can inspect CH activity.
      TTL bounds disk usage at 7 days.
    -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>

    <!--
      Larger memory envelope for the aggregation queries. Retention cohort query joins
      user_first_seen × events and needs ample working memory on realistic data volumes.
    -->
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>

    <!--
      Serialize Kafka consumer offset commits through ZooKeeper-less mode. With our
      2-broker KRaft cluster this is default but kept explicit to document intent.
    -->
    <kafka_consumers_hard_limit>16</kafka_consumers_hard_limit>

    <!-- Expose Prometheus metrics on port 9363 -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
