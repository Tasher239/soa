KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_TOPIC=movie-events

GENERATOR_ENABLED=true
GENERATOR_RPS=150
GENERATOR_CONCURRENT_USERS=50
GENERATOR_USER_POOL=500
GENERATOR_MOVIE_POOL=120

AGGREGATION_CRON=5 * * * *
AGGREGATION_S3_EXPORT_CRON=30 0 * * *
AGGREGATION_TIMEZONE=UTC

POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB=cinema
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cinema

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_BUCKET=movie-analytics
S3_REGION=us-east-1

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO
